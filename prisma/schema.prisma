// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// Enkel nyckel/värde-inställning för systemet (t.ex. standardgräns för
// kort bäst före-datum). Se skills/database-rules.md för hela datamodellen.
model AppSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

// Den gemensamma systeminloggningen (skills/authentication-and-pin.md, 21.1).
// Låser hela appen bakom en inloggning - separat från personalens PIN-koder.
model SystemUser {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

// En personalmedlem som kan bekräfta åtgärder med sin PIN-kod
// (skills/authentication-and-pin.md, 21.2-21.3). PIN sparas ALDRIG i klartext.
model StaffMember {
  id                Int       @id @default(autoincrement())
  name              String
  pinHash           String
  active            Boolean   @default(true)
  createdAt         DateTime  @default(now())
  lastUsedAt        DateTime?
  comment           String?
  // Bygger blockering/fördröjning av upprepade felaktiga PIN-försök
  // (skills/authentication-and-pin.md, 21.4).
  failedPinAttempts Int       @default(0)
  pinLockedUntil    DateTime?

  activityLogs         ActivityLog[]
  stockMovements       StockMovement[]
  completedPickupLists PickupList[]
  approvedDeliveries   Delivery[]
}

// Oföränderlig aktivitetslogg (skills/logging-and-audit-rules.md).
// Fler kopplingar (leverans, hämtlista, reklamation) läggs till i senare
// faser när de objekten finns.
model ActivityLog {
  id            Int      @id @default(autoincrement())
  eventType     String
  description   String
  previousValue String?
  newValue      String?
  reason        String?
  createdAt     DateTime @default(now())

  staffMember   StaffMember? @relation(fields: [staffMemberId], references: [id])
  staffMemberId Int?
}

// Fas 2 - Grundregister (skills/business-rules.md, punkt 5 och 6:
// varumärke och leverantör är olika register; kategorier används för
// filtrering av bl.a. bäst före-listan).

model Category {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  active   Boolean   @default(true)
  products Product[]
}

model Brand {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  active   Boolean   @default(true)
  comment  String?
  products Product[]
}

model Supplier {
  id                     Int      @id @default(autoincrement())
  name                   String
  orgNumber              String?
  customerNumber         String?
  generalEmail           String?
  complaintEmail         String?
  ccRecipient            String?
  phone                  String?
  contactPerson          String?
  notes                  String?
  complaintInstructions  String?
  // Standardgräns för kort bäst före-datum i dagar (skills/expiry-rules.md).
  // Null = använd systemets standard (90 dagar).
  defaultShortExpiryDays Int?
  active                 Boolean  @default(true)
  createdAt              DateTime @default(now())

  supplierProducts SupplierProduct[]
  deliveries       Delivery[]
}

// En produkt använder alltid den fasta enheten flak/pall
// (skills/business-rules.md, punkt 2) - därför finns inget "unit"-fält,
// det skulle bara vara ett skenbart val som ändå alltid är samma värde.
model Product {
  id                  Int       @id @default(autoincrement())
  // Hela Rubbets eget namn - kan skilja sig från leverantörens (skills, 6.1).
  name                String
  barcode             String?
  categoryId          Int?
  category            Category? @relation(fields: [categoryId], references: [id])
  brandId             Int?
  brand               Brand?    @relation(fields: [brandId], references: [id])
  minStockLevel       Int?
  normalOrderQuantity Int?
  active              Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  supplierProducts SupplierProduct[]
  stockBatches     StockBatch[]
  stockMovements   StockMovement[]
  pickupListItems  PickupListItem[]
  deliveryItems    DeliveryItem[]
}

// Kopplingen mellan en produkt och EN specifik leverantör
// (skills/business-rules.md, punkt 6: samma produkt kan köpas från flera
// leverantörer, varje koppling har sitt eget namn/artikelnummer).
model SupplierProduct {
  id                    Int      @id @default(autoincrement())
  productId             Int
  product               Product  @relation(fields: [productId], references: [id])
  supplierId            Int
  supplier              Supplier @relation(fields: [supplierId], references: [id])
  supplierProductName   String?
  supplierArticleNumber String?
  barcode               String?
  comment               String?
  createdAt             DateTime @default(now())

  @@unique([productId, supplierId])
}

// Fas 3 - Externt lager (skills/stock-and-pickup-rules.md).
// Lagret (till skillnad från Butik) har ett exakt, kontrollerat saldo.
// Ett lagerparti motsvarar en specifik "batch" av en produkt, med sitt
// eget bäst före-datum. Produktens totala lagersaldo = summan av
// quantity för alla dess aktiva (quantity > 0) lagerpartier.
model StockBatch {
  id         Int       @id @default(autoincrement())
  productId  Int
  product    Product   @relation(fields: [productId], references: [id])
  quantity   Int
  expiryDate DateTime?
  // Fritextreferens tills riktiga Delivery-kopplingen byggs i Fas 5.
  note       String?
  createdAt  DateTime  @default(now())

  movements StockMovement[]
}

// Oföränderlig lagerhistorik - varje förändring av ett lagersaldo skapar
// en NY rad här, historiken skrivs aldrig över (skills/business-rules.md,
// punkt 15).
model StockMovement {
  id            Int          @id @default(autoincrement())
  productId     Int
  product       Product      @relation(fields: [productId], references: [id])
  stockBatchId  Int?
  stockBatch    StockBatch?  @relation(fields: [stockBatchId], references: [id])
  // T.ex. "mottagen", "korrigering", "kassation".
  changeType    String
  quantityDelta Int
  reason        String?
  staffMemberId Int?
  staffMember   StaffMember? @relation(fields: [staffMemberId], references: [id])
  createdAt     DateTime     @default(now())
}

// Fas 4 - Hämtlistor, lager -> butik (skills/stock-and-pickup-rules.md).
enum PickupListStatus {
  UTKAST
  KLAR_ATT_HAMTA
  HAMTNING_PAGAR
  SLUTFORD
  AVBRUTEN
}

model PickupList {
  id          Int              @id @default(autoincrement())
  status      PickupListStatus @default(UTKAST)
  comment     String?
  createdAt   DateTime         @default(now())
  completedAt DateTime?

  completedByStaffMemberId Int?
  completedByStaffMember   StaffMember? @relation(fields: [completedByStaffMemberId], references: [id])

  items PickupListItem[]
}

// En rad i hämtlistan för en specifik produkt. `requestedQuantity` är vad
// som ska hämtas (reserveras virtuellt ur lagersaldot innan hämtning);
// `actualQuantity` är vad som faktiskt hämtades (kan skilja sig om varan
// saknades eller bara delvis fanns, skills, punkt 10.3).
model PickupListItem {
  id                Int        @id @default(autoincrement())
  pickupListId      Int
  pickupList        PickupList @relation(fields: [pickupListId], references: [id], onDelete: Cascade)
  productId         Int
  product           Product    @relation(fields: [productId], references: [id])
  requestedQuantity Int
  actualQuantity    Int?
  isMissing         Boolean    @default(false)
  isPartial         Boolean    @default(false)
  comment           String?
  pickedAt          DateTime?
}

// Fas 5 - Manuell inleverans (skills/delivery-and-ai-rules.md).
// AI-tolkning (Fas 6) fyller i samma tabeller senare - Fas 5 bygger bara
// det manuella flödet, så productId är obligatoriskt (personalen väljer
// alltid en befintlig produkt direkt, ingen "okopplad rad" ännu).
enum DeliveryStatus {
  UTKAST
  GODKAND
}

model Delivery {
  id            Int            @id @default(autoincrement())
  supplierId    Int
  supplier      Supplier       @relation(fields: [supplierId], references: [id])
  deliveryDate  DateTime?
  orderNumber   String?
  invoiceNumber String?
  comment       String?
  status        DeliveryStatus @default(UTKAST)
  createdAt     DateTime       @default(now())
  approvedAt    DateTime?

  approvedByStaffMemberId Int?
  approvedByStaffMember   StaffMember? @relation(fields: [approvedByStaffMemberId], references: [id])

  items     DeliveryItem[]
  documents DeliveryDocument[]
}

// Det uppladdade originaldokumentet (faktura/följesedel) - bara sparat som
// bilaga i Fas 5, AI läser INTE innehållet förrän Fas 6.
model DeliveryDocument {
  id         Int      @id @default(autoincrement())
  deliveryId Int
  delivery   Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  filePath   String
  fileName   String
  createdAt  DateTime @default(now())
}

model DeliveryItem {
  id                  Int       @id @default(autoincrement())
  deliveryId          Int
  delivery            Delivery  @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  productId           Int
  product             Product   @relation(fields: [productId], references: [id])
  documentedQuantity  Int
  receivedQuantity    Int?
  expiryDate          DateTime?
  // "Markera rad som klar" (skills, 13.1).
  confirmedOk         Boolean   @default(false)
  // Hantering av kort bäst före-datum vid inleverans (skills/expiry-rules.md, 15.2).
  shortExpiryHandled  Boolean   @default(false)
  shortExpiryDecision String?
  comment             String?
  createdAt           DateTime  @default(now())

  issues DeliveryIssue[]
}

enum DeliveryIssueType {
  SAKNAS_HELT
  FARRE_MOTTAGNA
  FLER_MOTTAGNA
  EJ_PA_FAKTURA
  FEL_PRODUKT
  SKADAD
  KORT_BAST_FORE
  FELAKTIGT_PRIS
  ANNAN
}

model DeliveryIssue {
  id              Int               @id @default(autoincrement())
  deliveryItemId  Int
  deliveryItem    DeliveryItem      @relation(fields: [deliveryItemId], references: [id], onDelete: Cascade)
  type            DeliveryIssueType
  comment         String?
  // Fält specifika för skadade varor (skills, 14. Skadade produkter).
  damagedQuantity Int?
  discarded       Boolean?
  wantedAction    String?
  createdAt       DateTime          @default(now())

  images DamageImage[]
}

model DamageImage {
  id              Int           @id @default(autoincrement())
  deliveryIssueId Int
  deliveryIssue   DeliveryIssue @relation(fields: [deliveryIssueId], references: [id], onDelete: Cascade)
  filePath        String
  createdAt       DateTime      @default(now())
}
