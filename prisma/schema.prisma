// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// Enkel nyckel/värde-inställning för systemet (t.ex. standardgräns för
// kort bäst före-datum). Se skills/database-rules.md för hela datamodellen.
model AppSetting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

// Den gemensamma systeminloggningen (skills/authentication-and-pin.md, 21.1).
// Låser hela appen bakom en inloggning - separat från personalens PIN-koder.
model SystemUser {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

// En personalmedlem som kan bekräfta åtgärder med sin PIN-kod
// (skills/authentication-and-pin.md, 21.2-21.3). PIN sparas ALDRIG i klartext.
model StaffMember {
  id                Int       @id @default(autoincrement())
  name              String
  pinHash           String
  active            Boolean   @default(true)
  createdAt         DateTime  @default(now())
  lastUsedAt        DateTime?
  comment           String?
  // Bygger blockering/fördröjning av upprepade felaktiga PIN-försök
  // (skills/authentication-and-pin.md, 21.4).
  failedPinAttempts Int       @default(0)
  pinLockedUntil    DateTime?

  activityLogs   ActivityLog[]
  stockMovements StockMovement[]
}

// Oföränderlig aktivitetslogg (skills/logging-and-audit-rules.md).
// Fler kopplingar (leverans, hämtlista, reklamation) läggs till i senare
// faser när de objekten finns.
model ActivityLog {
  id            Int      @id @default(autoincrement())
  eventType     String
  description   String
  previousValue String?
  newValue      String?
  reason        String?
  createdAt     DateTime @default(now())

  staffMember   StaffMember? @relation(fields: [staffMemberId], references: [id])
  staffMemberId Int?
}

// Fas 2 - Grundregister (skills/business-rules.md, punkt 5 och 6:
// varumärke och leverantör är olika register; kategorier används för
// filtrering av bl.a. bäst före-listan).

model Category {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  active   Boolean   @default(true)
  products Product[]
}

model Brand {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  active   Boolean   @default(true)
  comment  String?
  products Product[]
}

model Supplier {
  id                     Int      @id @default(autoincrement())
  name                   String
  orgNumber              String?
  customerNumber         String?
  generalEmail           String?
  complaintEmail         String?
  ccRecipient            String?
  phone                  String?
  contactPerson          String?
  notes                  String?
  complaintInstructions  String?
  // Standardgräns för kort bäst före-datum i dagar (skills/expiry-rules.md).
  // Null = använd systemets standard (90 dagar).
  defaultShortExpiryDays Int?
  active                 Boolean  @default(true)
  createdAt              DateTime @default(now())

  supplierProducts SupplierProduct[]
}

// En produkt använder alltid den fasta enheten flak/pall
// (skills/business-rules.md, punkt 2) - därför finns inget "unit"-fält,
// det skulle bara vara ett skenbart val som ändå alltid är samma värde.
model Product {
  id                  Int       @id @default(autoincrement())
  // Hela Rubbets eget namn - kan skilja sig från leverantörens (skills, 6.1).
  name                String
  barcode             String?
  categoryId          Int?
  category            Category? @relation(fields: [categoryId], references: [id])
  brandId             Int?
  brand               Brand?    @relation(fields: [brandId], references: [id])
  minStockLevel       Int?
  normalOrderQuantity Int?
  active              Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  supplierProducts SupplierProduct[]
  stockBatches     StockBatch[]
  stockMovements   StockMovement[]
}

// Kopplingen mellan en produkt och EN specifik leverantör
// (skills/business-rules.md, punkt 6: samma produkt kan köpas från flera
// leverantörer, varje koppling har sitt eget namn/artikelnummer).
model SupplierProduct {
  id                    Int      @id @default(autoincrement())
  productId             Int
  product               Product  @relation(fields: [productId], references: [id])
  supplierId            Int
  supplier              Supplier @relation(fields: [supplierId], references: [id])
  supplierProductName   String?
  supplierArticleNumber String?
  barcode               String?
  comment               String?
  createdAt             DateTime @default(now())

  @@unique([productId, supplierId])
}

// Fas 3 - Externt lager (skills/stock-and-pickup-rules.md).
// Lagret (till skillnad från Butik) har ett exakt, kontrollerat saldo.
// Ett lagerparti motsvarar en specifik "batch" av en produkt, med sitt
// eget bäst före-datum. Produktens totala lagersaldo = summan av
// quantity för alla dess aktiva (quantity > 0) lagerpartier.
model StockBatch {
  id         Int       @id @default(autoincrement())
  productId  Int
  product    Product   @relation(fields: [productId], references: [id])
  quantity   Int
  expiryDate DateTime?
  // Fritextreferens tills riktiga Delivery-kopplingen byggs i Fas 5.
  note       String?
  createdAt  DateTime  @default(now())

  movements StockMovement[]
}

// Oföränderlig lagerhistorik - varje förändring av ett lagersaldo skapar
// en NY rad här, historiken skrivs aldrig över (skills/business-rules.md,
// punkt 15).
model StockMovement {
  id            Int          @id @default(autoincrement())
  productId     Int
  product       Product      @relation(fields: [productId], references: [id])
  stockBatchId  Int?
  stockBatch    StockBatch?  @relation(fields: [stockBatchId], references: [id])
  // T.ex. "mottagen", "korrigering", "kassation".
  changeType    String
  quantityDelta Int
  reason        String?
  staffMemberId Int?
  staffMember   StaffMember? @relation(fields: [staffMemberId], references: [id])
  createdAt     DateTime     @default(now())
}
